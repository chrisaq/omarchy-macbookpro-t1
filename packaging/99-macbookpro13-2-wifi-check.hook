[Trigger]
Operation = Install
Operation = Upgrade
Type = Path
Target = usr/lib/firmware/*
Target = usr/lib/modules/*/modules.builtin
Target = usr/lib/initcpio/*

[Action]
Description = Verify MacBookPro13,2 Wi-Fi NVRAM and Omarchy boot integrity
When = PostTransaction
Exec = /usr/local/lib/macbookpro13-2-omarchy/wifi check --boot --if-installed
