import hashlib
import os
from pathlib import Path
import subprocess
import sys

NAME = 'mbp13-2-brcmfmac'
VERSION = '7.2.5.1'

def run(*args):
    return subprocess.check_output(args, text=True).strip()

def main():
    if sys.argv[1:] not in ([], ['--all']):
        raise RuntimeError('Usage: mbp13-2-wifi-resume-check [--all]')
    if Path('/sys/class/dmi/id/product_name').read_text().strip() != 'MacBookPro13,2':
        raise RuntimeError('Unsupported model')
    if os.geteuid() != 0:
        raise RuntimeError('Run with sudo to check boot integrity')
    subprocess.run(['sha256sum', '-c', '/usr/share/mbp13-2-wifi-resume/files.sha256', '--quiet'], cwd='/', check=True)
    kernels = sorted(p.name for p in Path('/usr/lib/modules').iterdir() if (p / 'kernel').is_dir()) if '--all' in sys.argv else [os.uname().release]
    if not kernels:
        raise RuntimeError('No installed kernels')
    for kernel in kernels:
        if not Path('/usr/lib/modules', kernel, 'build/include').is_dir():
            raise RuntimeError('Headers missing for ' + kernel)
        state = run('dkms', 'status', '-m', NAME, '-v', VERSION, '-k', kernel)
        if ': installed' not in state:
            raise RuntimeError('DKMS build/install missing for ' + kernel)
        module = Path(run('modinfo', '-k', kernel, '-n', 'brcmfmac'))
        if '/updates/dkms/' not in str(module):
            raise RuntimeError('Another brcmfmac override selected: ' + str(module))
        if run('modinfo', '-F', 'vermagic', str(module)).split()[0] != kernel:
            raise RuntimeError('Module vermagic mismatch for ' + kernel)
        # DKMS may compress its saved signed module, according to distro configuration.
        directory = Path('/var/lib/dkms', NAME, VERSION, kernel, 'x86_64/module')
        candidates = [directory / ('brcmfmac.ko' + suffix) for suffix in ('', '.zst', '.xz', '.gz')]
        candidates = [path for path in candidates if path.is_file()]
        if len(candidates) != 1:
            raise RuntimeError('Expected one DKMS candidate binary in ' + str(directory))
        built = candidates[0]
        if run('modinfo', '-F', 'srcversion', str(module)) != run('modinfo', '-F', 'srcversion', str(built)):
            raise RuntimeError('Selected driver is not this DKMS build')
        print('PASS: Wi-Fi DKMS installed and selected for ' + kernel)
        if kernel == os.uname().release:
            loaded = Path('/sys/module/brcmfmac/srcversion')
            if not loaded.is_file():
                print('Running Wi-Fi module: absent')
            elif loaded.read_text().strip() == run('modinfo', '-F', 'srcversion', str(built)):
                print('Running Wi-Fi module: patched source matches')
            else:
                print('Running Wi-Fi module differs; reboot required to test this build')
    subprocess.run(['/usr/lib/mbp13-2-wifi-resume/boot-integrity'], check=True)
    print('PASS: disk builds and boot integrity. Test connectivity/suspend after kernel changes.')

if __name__ == '__main__':
    try:
        main()
    except (OSError, RuntimeError, subprocess.SubprocessError) as error:
        print('FAIL: ' + str(error), file=sys.stderr)
        sys.exit(1)
