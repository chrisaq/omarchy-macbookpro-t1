#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-2.0-only
"""Pinned BCM43602 board-configuration preparation, installation and checks."""
import argparse
from contextlib import contextmanager
import fcntl
import getpass
import hashlib
import importlib.machinery
import importlib.util
import json
import os
from pathlib import Path
import re
import shutil
import subprocess
import tempfile
import urllib.request

ROOT = Path(__file__).resolve().parent
COMMIT = '8e479f0af82d16f47de811bef6e1a5cfd7d8c5f8'
URL = f'https://raw.githubusercontent.com/nohzafk/omarchy-macbookpro-t1/{COMMIT}/firmware/brcmfmac43602-pcie.txt'
TEMPLATE_SHA256 = 'b109f3e6663b0e888c2559e36f7e0109f2a3a6b9765786d11f849f16d4b32d06'
PLACEHOLDER = b'macaddr=xx:xx:xx:xx:xx:xx'
NAME = 'brcmfmac43602-pcie.Apple Inc.-MacBookPro13,2.txt'
TARGET = Path('/usr/lib/firmware/brcm') / NAME
STATE = Path('/var/lib/macbookpro13-2-omarchy/wifi')
RECORD = STATE / 'installed.json'
HELPERS = Path('/usr/local/lib/macbookpro13-2-omarchy')
HOOK = Path('/etc/pacman.d/hooks/99-macbookpro13-2-wifi-check.hook')
IMAGE = Path('/boot/EFI/Linux/omarchy_linux-omarchy.efi')
DROPIN = Path('/etc/mkinitcpio.conf.d/macbookpro13-2-wifi.conf')
DROPIN_DATA = ('# Managed by macbookpro13-2-omarchy/scripts/wifi\nFILES+=("' + str(TARGET) + '")\n').encode()



def sha(data):
    return hashlib.sha256(data).hexdigest()


def validate_mac(value):
    if not re.fullmatch(r'(?:[0-9a-fA-F]{2}:){5}[0-9a-fA-F]{2}', value):
        raise RuntimeError('Enter the original Wi-Fi MAC as six hexadecimal pairs separated by colons.')
    value = value.lower()
    if int(value[:2], 16) & 1 or value == '00:00:00:00:00:00' or value.startswith('00:90:4c:'):
        raise RuntimeError('Multicast, zero and Broadcom placeholder addresses are not original Wi-Fi MACs.')
    return value


def personalize(template, mac):
    if sha(template) != TEMPLATE_SHA256 or template.splitlines().count(PLACEHOLDER) != 1:
        raise RuntimeError('Candidate does not match the pinned template checksum.')
    return template.replace(PLACEHOLDER, b'macaddr=' + validate_mac(mac).encode())


def validate_candidate(data):
    lines = re.findall(rb'^macaddr=([^\r\n]+)$', data, re.MULTILINE)
    if len(lines) != 1:
        raise RuntimeError('Candidate must have exactly one macaddr field.')
    mac = validate_mac(lines[0].decode('ascii'))
    if personalize(re.sub(rb'^macaddr=[^\r\n]+$', PLACEHOLDER, data, flags=re.MULTILINE), mac) != data:
        raise RuntimeError('Candidate differs from the pinned template beyond its MAC field.')
    return sha(data)


def prepare(args):
    if os.geteuid() == 0:
        raise RuntimeError('Prepare as your normal user, not with sudo.')
    mac = args.mac or getpass.getpass('Original Wi-Fi MAC from macOS (input hidden): ')
    validate_mac(mac)
    if args.source:
        template = args.source.read_bytes()
    else:
        with urllib.request.urlopen(URL, timeout=30) as response:
            template = response.read(65537)
    data = personalize(template, mac)
    output = args.output
    output.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    # Exclusive creation: never overwrite a previous personalized candidate.
    descriptor = os.open(output, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    with os.fdopen(descriptor, 'wb') as stream:
        stream.write(data)
    print(f'Prepared private candidate: {output}\nSHA256: {sha(data)}\nNo system configuration changed.')


def require_hardware():
    if os.geteuid() != 0:
        raise RuntimeError('Run this command with sudo.')
    if Path('/sys/class/dmi/id/product_name').read_text().strip() != 'MacBookPro13,2':
        raise RuntimeError('Only MacBookPro13,2 is supported.')
    for pci in Path('/sys/bus/pci/devices').iterdir():
        values = [pci / field for field in ('vendor', 'device', 'subsystem_vendor', 'subsystem_device')]
        if all(path.exists() for path in values) and [path.read_text().strip() for path in values] == ['0x14e4', '0x43ba', '0x106b', '0x0157']:
            return
    raise RuntimeError('Expected Apple BCM43602 PCI adapter not found.')


@contextmanager
def lock():
    with open('/run/lock/macbookpro13-2-wifi.lock', 'a') as stream:
        fcntl.flock(stream, fcntl.LOCK_EX | fcntl.LOCK_NB)
        yield


def run(command, **kwargs):
    return subprocess.check_output(command, text=True, **kwargs)


def boot_check():
    loader = importlib.machinery.SourceFileLoader('wifi_boot_integrity', str(ROOT / 'boot-integrity'))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    if not module.inspect(Path('/boot')):
        raise RuntimeError('Boot hash mismatch; repair it before changing Wi-Fi files.')


def inspect_initramfs(expected=None):
    """Read via a separate objcopy output; check embedded candidate when present."""
    for tool in ('objcopy', 'lsinitcpio'):
        if not shutil.which(tool):
            raise RuntimeError(f'Missing prerequisite: {tool}')
    before = sha(IMAGE.read_bytes())
    with tempfile.TemporaryDirectory(prefix='wifi-initramfs-') as folder:
        work = Path(folder)
        archive = work / 'initrd'
        run(['objcopy', '--dump-section', f'.initrd={archive}', str(IMAGE), str(work / 'copy.efi')])
        listing = run(['lsinitcpio', str(archive)])
        early = bool(re.search(r'brcmfmac[^\n]*\.ko|brcmfmac43602', listing))
        if expected and early:
            extract = work / 'extracted'
            extract.mkdir()
            run(['lsinitcpio', '--extract', str(archive)], cwd=extract)
            embedded = extract / 'usr/lib/firmware/brcm' / NAME
            if not embedded.resolve().is_relative_to(extract.resolve()) or not embedded.is_file() or sha(embedded.read_bytes()) != expected:
                raise RuntimeError('Early Wi-Fi exists but its model-specific NVRAM is absent or stale; inspect mkinitcpio firmware inclusion.')
    if sha(IMAGE.read_bytes()) != before:
        raise RuntimeError('UKI changed during read-only inspection.')
    print('Early Wi-Fi files: ' + ('present' if early else 'absent; root-filesystem NVRAM is used'))
    return early


def read_record():
    record = json.loads(RECORD.read_text())
    if record.get('template_sha256') != TEMPLATE_SHA256 or not re.fullmatch(r'[0-9a-f]{64}', record.get('sha256', '')):
        raise RuntimeError('Invalid installation record; inspect it manually.')
    return record


def check(args):
    require_hardware()
    if not RECORD.exists():
        if args.if_installed:
            print('NOTE: Wi-Fi candidate is not managed by these scripts; nothing checked.')
            return
        raise RuntimeError('No managed Wi-Fi installation; install or adopt first.')
    record = read_record()
    if TARGET.is_symlink() or not TARGET.is_file() or sha(TARGET.read_bytes()) != record['sha256']:
        raise RuntimeError('Installed Wi-Fi candidate is missing or modified; no automatic replacement performed.')
    validate_candidate(TARGET.read_bytes())
    if record.get('dropin_sha256'):
        if DROPIN.is_symlink() or not DROPIN.is_file() or sha(DROPIN.read_bytes()) != record['dropin_sha256']:
            raise RuntimeError('Managed Wi-Fi mkinitcpio drop-in is missing or modified.')
    if args.boot:
        boot_check()
        inspect_initramfs(record['sha256'])
    print('PASS: installed pinned Wi-Fi candidate matches its private installation record. Connectivity still needs testing.')


def deploy_helpers():
    HELPERS.mkdir(parents=True, exist_ok=True, mode=0o755)
    for name in ('wifi', 'boot-integrity'):
        path = HELPERS / name
        if path.is_symlink():
            raise RuntimeError('Refusing a symlink at the installed helper path.')
        shutil.copyfile(ROOT / name, path)
        path.chmod(0o755)
        os.chown(path, 0, 0)
    hook_source = ROOT.parent / 'packaging/99-macbookpro13-2-wifi-check.hook'
    if not hook_source.is_file():
        raise RuntimeError('Install/adopt from the source checkout containing packaging/.')
    HOOK.parent.mkdir(parents=True, exist_ok=True)
    if HOOK.is_symlink():
        raise RuntimeError('Refusing a symlink at the hook path.')
    shutil.copyfile(hook_source, HOOK)
    HOOK.chmod(0o644)
    os.chown(HOOK, 0, 0)


def install(args):
    require_hardware()
    with lock():
        if RECORD.exists():
            raise RuntimeError('Already managed: use check; no reinstallation is needed.')
        if not (ROOT.parent / 'packaging/99-macbookpro13-2-wifi-check.hook').is_file():
            raise RuntimeError('Run install/adopt from the complete source checkout.')
        if args.command == 'adopt':
            if TARGET.is_symlink() or not TARGET.is_file():
                raise RuntimeError('No regular existing model-specific NVRAM to adopt.')
            ownership = subprocess.run(['pacman', '-Qqo', str(TARGET)], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            if ownership.returncode == 0:
                raise RuntimeError('A package owns this override; do not adopt or remove it with this script.')
            data = TARGET.read_bytes()
        else:
            data = args.candidate.read_bytes()
            for name in (NAME, 'brcmfmac43602-pcie.txt'):
                for suffix in ('', '.zst', '.xz', '.gz'):
                    path = TARGET.parent / (name + suffix)
                    if path.exists() or path.is_symlink():
                        raise RuntimeError('An NVRAM override already exists; preserve it or use adopt for the tested model-specific file.')
        digest = validate_candidate(data)
        boot_check()
        early = inspect_initramfs()
        if early and (DROPIN.exists() or DROPIN.is_symlink()):
            raise RuntimeError('Existing Wi-Fi initramfs drop-in; preserve and review it first.')
        # Private retained recovery copy, including when registering an existing file.
        STATE.mkdir(parents=True, exist_ok=True, mode=0o700)
        STATE.chmod(0o700)
        backup = STATE / 'candidate.txt'
        backup.write_bytes(data)
        backup.chmod(0o600)
        # Record before changing firmware, so a later failure has a rollback path.
        RECORD.write_text(json.dumps({'sha256': digest, 'template_sha256': TEMPLATE_SHA256, 'source_commit': COMMIT, 'adopted': args.command == 'adopt'}, indent=2) + '\n')
        RECORD.chmod(0o600)
        if args.command != 'adopt':
            TARGET.parent.mkdir(parents=True, exist_ok=True)
            descriptor = os.open(TARGET, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o644)
            with os.fdopen(descriptor, 'wb') as stream:
                stream.write(data)
        deploy_helpers()
        if early:
            _sync_boot(argparse.Namespace())
        check(argparse.Namespace(boot=True, if_installed=False))
        print('Registered existing file without rewriting it.' if args.command == 'adopt' else 'Installed one model-specific NVRAM candidate.')
        print('Upgrade validation hook installed. No live driver reload or reboot occurred.')
        if args.command == 'adopt':
            print('Existing connection left active; no reboot is needed to register checks.')
        else:
            print('Cold boot when ready and repeat status/functional tests.')


def update_checks(args):
    require_hardware()
    with lock():
        check(argparse.Namespace(boot=True, if_installed=False))
        deploy_helpers()
        print('Updated root-owned validation helpers and hook. Firmware and UKI were not changed.')


def sync_boot(args):
    require_hardware()
    with lock():
        _sync_boot(args)


def _sync_boot(args):
    # Can also repair a future upgrade that begins loading Wi-Fi in early boot.
    require_hardware()
    check(argparse.Namespace(boot=False, if_installed=False))
    record = read_record()
    if DROPIN.exists() or DROPIN.is_symlink():
        if DROPIN.is_symlink() or not record.get('dropin_sha256') or sha(DROPIN.read_bytes()) != record['dropin_sha256']:
            raise RuntimeError('Existing or modified Wi-Fi initramfs drop-in; refusing to overwrite it.')
    else:
        DROPIN.parent.mkdir(parents=True, exist_ok=True)
        descriptor = os.open(DROPIN, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o644)
        with os.fdopen(descriptor, 'wb') as stream:
            stream.write(DROPIN_DATA)
    record['dropin_sha256'] = sha(DROPIN_DATA)
    RECORD.write_text(json.dumps(record, indent=2) + '\n')
    RECORD.chmod(0o600)
    subprocess.run([str(ROOT / 'boot-integrity'), '--repair'], check=True)
    check(argparse.Namespace(boot=True, if_installed=False))


def rollback(args):
    require_hardware()
    with lock():
        record = read_record()
        if TARGET.is_symlink() or (TARGET.exists() and sha(TARGET.read_bytes()) != record['sha256']):
            raise RuntimeError('File modified; refusing to delete it.')
        if not TARGET.exists() and not record.get('rollback_pending'):
            raise RuntimeError('File missing without a pending rollback; inspect it manually.')
        if record.get('dropin_sha256') and DROPIN.exists():
            if DROPIN.is_symlink() or sha(DROPIN.read_bytes()) != record['dropin_sha256']:
                raise RuntimeError('Managed drop-in modified; refusing to delete it.')
        boot_check()
        early = inspect_initramfs()
        record['rollback_pending'] = True
        RECORD.write_text(json.dumps(record, indent=2) + '\n')
        TARGET.unlink(missing_ok=True)
        if record.get('dropin_sha256'):
            DROPIN.unlink(missing_ok=True)
        if early or record.get('dropin_sha256'):
            subprocess.run([str(ROOT / 'boot-integrity'), '--repair'], check=True)
        boot_check()
        if early:
            # Keep the record until removal from early boot is confirmed as well.
            with tempfile.TemporaryDirectory(prefix='wifi-rollback-') as folder:
                archive = Path(folder) / 'initrd'
                run(['objcopy', '--dump-section', f'.initrd={archive}', str(IMAGE), str(Path(folder) / 'copy.efi')])
                if NAME in run(['lsinitcpio', str(archive)]):
                    raise RuntimeError('Removed candidate remains in the initramfs; investigate before reboot.')
        RECORD.unlink()
        print('Removed only the registered candidate. Private recovery copy retained; upgrade hook is now inactive. Cold boot when ready.')


def status(args):
    require_hardware()
    interfaces = []
    for interface in Path('/sys/class/net').iterdir():
        driver = interface / 'device/driver'
        if driver.exists() and driver.resolve().name == 'brcmfmac':
            interfaces.append(interface.name)
    if len(interfaces) != 1:
        raise RuntimeError('Expected exactly one brcmfmac network interface.')
    name = interfaces[0]
    print('Current connection (SSID/AP address omitted):')
    for line in run(['iw', 'dev', name, 'link']).splitlines():
        if re.search(r'freq:|signal:|bitrate:|Not connected', line):
            print(line.strip())
    print(run(['iw', 'dev', name, 'get', 'power_save']), end='')
    print('Supported bands:')
    for line in run(['iw', 'phy']).splitlines():
        if re.search(r'Band [0-9]', line):
            print(line.strip())
    print('Regulatory domains:\n' + run(['iw', 'reg', 'get']), end='')
    print('Model-specific NVRAM: ' + ('present' if TARGET.is_file() else 'absent'))
    boot_check()
    inspect_initramfs()
    if RECORD.exists():
        check(argparse.Namespace(boot=False, if_installed=False))


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    commands = parser.add_subparsers(dest='command', required=True)
    prepare_parser = commands.add_parser('prepare', help='download/verify pinned template and personalize it locally')
    prepare_parser.add_argument('--source', type=Path, help='exact pinned local template instead of download')
    prepare_parser.add_argument('--mac', help='original Wi-Fi MAC; omitted means a hidden prompt')
    prepare_parser.add_argument('--output', type=Path, default=ROOT.parent / 'build/wifi/candidate.txt')
    install_parser = commands.add_parser('install', help='install a prepared candidate and persistent upgrade checks')
    install_parser.add_argument('candidate', type=Path)
    commands.add_parser('adopt', help='register an existing tested candidate; do not rewrite it')
    check_parser = commands.add_parser('check', help='read-only integrity check')
    check_parser.add_argument('--boot', action='store_true', help='also verify boot hash and early Wi-Fi contents')
    check_parser.add_argument('--if-installed', action='store_true', help='succeed with a note when unmanaged')
    commands.add_parser('status', help='privacy-conscious link, band, firmware and boot inventory')
    commands.add_parser('update-checks', help='refresh installed validation helpers from a reviewed checkout')
    commands.add_parser('sync-boot', help='include the registered candidate in initramfs and rebuild/verify UKI')
    commands.add_parser('rollback', help='remove only the checksum-matching installed candidate')
    args = parser.parse_args()
    try:
        {'adopt': install, 'sync-boot': sync_boot, 'update-checks': update_checks}.get(args.command, globals().get(args.command))(args)
        return 0
    except (OSError, RuntimeError, ValueError, subprocess.SubprocessError) as error:
        print(f'STOP: {error}')
        return 1

if __name__ == '__main__':
    raise SystemExit(main())
