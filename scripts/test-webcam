#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-2.0-only
set -euo pipefail
[[ $# -eq 1 && $1 == /dev/video* && -c $1 ]] || { echo 'Usage: test-webcam /dev/videoN (choose with v4l2-ctl --list-devices)' >&2; exit 2; }
command -v ffplay >/dev/null || { echo 'Install ffmpeg first.' >&2; exit 1; }
printf 'Showing live camera video. Press q to exit. No recording is saved.\n'
ffplay -f video4linux2 -i "$1"
printf 'If video was clear and updating, record an observed webcam pass. Process success alone is insufficient.\n'
